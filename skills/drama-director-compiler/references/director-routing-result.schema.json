{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "director-routing-result.schema.json",
  "title": "DirectorMind routing result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "status",
    "scene_problem",
    "applied_constraint_ids",
    "eligible_rule_ids",
    "selected_rules",
    "rejected_rules",
    "conflict_trace",
    "selection_count",
    "ir_handoff",
    "human_review_status",
    "rights_boundary"
  ],
  "properties": {
    "schema_version": {"const": "director-routing-result/0.1"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["SELECTED", "NO_APPLICABLE_RULE", "HUMAN_REVIEW_REQUIRED"]},
    "scene_problem": {"$ref": "#/$defs/sceneProblemValue"},
    "applied_constraint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "eligible_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selected_rules": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "selection_reason_codes", "matched_fact_ids"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "selection_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "matched_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rejected_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "rejection_reason_codes", "matched_not_applicable_signal_ids", "missing_fact_types", "blocking_fact_ids", "conflicting_rule_ids"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "rejection_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "matched_not_applicable_signal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "missing_fact_types": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "blocking_fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "conflicting_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "conflict_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority_level", "winner_id", "loser_id", "resolution_code"],
        "properties": {
          "priority_level": {"type": "string", "minLength": 1},
          "winner_id": {"type": "string", "minLength": 1},
          "loser_id": {"type": "string", "minLength": 1},
          "resolution_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "ir_handoff": {"enum": ["CONTINUE_WITH_SELECTED_RULES", "CONTINUE_WITH_PROJECT_CONSTRAINTS_ONLY", "PAUSE_FOR_HUMAN"]},
    "human_review_status": {"const": "HUMAN_REVIEW_PENDING"},
    "rights_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_copy_allowed", "subject_matter_used_for_selection"],
      "properties": {
        "surface_copy_allowed": {"const": false},
        "subject_matter_used_for_selection": {"const": false}
      }
    }
  },
  "$defs": {
    "sceneProblemValue": {
      "enum": [
        "DIALOGUE_POWER_TRANSFER",
        "RELATIONSHIP_FRACTURE",
        "PUBLIC_REVELATION",
        "GROUP_POWER_CHANGE",
        "PROCEDURAL_COMPETENCE",
        "PROCEDURAL_COLLAPSE",
        "INTERROGATION",
        "SUBJECTIVE_COERCION",
        "SUSPENSE_INFORMATION_ASYMMETRY",
        "ACTION_CAUSALITY",
        "HORROR_RULE_REVELATION",
        "ROMANTIC_PROXIMITY",
        "SOUND_LED_CAUSALITY",
        "MONTAGE_TIME_COMPRESSION",
        "ENSEMBLE_REACTION_CHAIN",
        "SILENT_AFTERMATH",
        "NO_SPECIALIZED_PROBLEM",
        "LEGACY_SCENE_PROBLEM"
      ]
    }
  }
}
