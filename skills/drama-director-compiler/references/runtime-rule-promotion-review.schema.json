{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-rule-promotion-review.schema.json",
  "title": "DirectorMind runtime rule promotion review v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "audio_review_status", "evidence_reviews", "promotions"],
  "properties": {
    "schema_version": {"const": "runtime-rule-promotion-review/0.1"},
    "status": {"const": "ROOT_VIDEO_VERIFIED"},
    "audio_review_status": {"const": "NOT_REQUIRED_FOR_VISUAL_RULES"},
    "evidence_reviews": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/evidenceReview"}
    },
    "promotions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/promotion"}
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sceneProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "status", "source_refs", "notes"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "secondary": {"$ref": "#/$defs/stringArray"},
        "status": {"const": "INFERRED"},
        "source_refs": {"$ref": "#/$defs/nonEmptyStringArray"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "appearance_id", "functional_role", "source_refs"],
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "appearance_id": {"type": "string", "minLength": 1},
        "functional_role": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "timePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timecode", "seconds"],
      "properties": {
        "timecode": {"type": "string", "pattern": "^[0-9]{2,}:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?$"},
        "seconds": {"type": "number", "minimum": 0}
      }
    },
    "textAnchorReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "shot_id", "source_type", "paraphrase", "speaker_status", "start", "end"],
      "properties": {
        "anchor_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
        "shot_id": {"type": "string", "minLength": 1},
        "source_type": {"const": "SUBTITLE"},
        "paraphrase": {"type": "string", "minLength": 1},
        "speaker_status": {"enum": ["VERIFIED", "INFERRED", "UNKNOWN"]},
        "start": {"$ref": "#/$defs/timePoint"},
        "end": {"$ref": "#/$defs/timePoint"}
      }
    },
    "evidenceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "evidence_id", "method_id", "text_anchor", "shot_ids", "observations", "unknowns", "scene_problem", "roles"],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "minLength": 1},
        "text_anchor": {"anyOf": [{"$ref": "#/$defs/textAnchorReview"}, {"type": "null"}]},
        "shot_ids": {"$ref": "#/$defs/nonEmptyStringArray"},
        "observations": {"$ref": "#/$defs/nonEmptyStringArray"},
        "unknowns": {"$ref": "#/$defs/nonEmptyStringArray"},
        "scene_problem": {"anyOf": [{"$ref": "#/$defs/sceneProblem"}, {"type": "null"}]},
        "roles": {"type": "array", "items": {"$ref": "#/$defs/role"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "source_candidate_rule_id", "work_id", "evidence_id", "source_refs", "notes"],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "source_candidate_rule_id": {"type": "string", "minLength": 1},
        "work_id": {"type": "string", "minLength": 1},
        "evidence_id": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStringArray"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "performance", "continuity"],
      "properties": {
        "camera": {"$ref": "#/$defs/riskDimension"},
        "performance": {"$ref": "#/$defs/riskDimension"},
        "continuity": {"$ref": "#/$defs/riskDimension"}
      }
    },
    "riskDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "reasons": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "performance", "continuity", "project_original_only"],
      "properties": {
        "camera": {"type": "string", "minLength": 1},
        "performance": {"type": "string", "minLength": 1},
        "continuity": {"type": "string", "minLength": 1},
        "project_original_only": {"type": "boolean", "const": true}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "name", "candidate_rule_id", "family_id", "scene_problem", "source_refs", "functional_roles",
        "trigger", "routing", "required_story_facts", "applicable_when", "not_applicable_when",
        "director_decision", "coverage", "blocking", "pacing", "edit_logic", "continuity",
        "ai_risk", "failure_modes", "fallback", "confidence", "supporting_relations",
        "counterexample", "positive_forward_test_id", "boundary_forward_test_id", "selection_rank",
        "audio_dependency", "runtime_authorized", "surface_copy_allowed"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^DR-[A-Z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "candidate_rule_id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "scene_problem": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/nonEmptyStringArray"},
        "functional_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/role"}},
        "trigger": {"type": "string", "minLength": 1},
        "routing": {
          "type": "object", "additionalProperties": false,
          "required": ["trigger_all_of", "trigger_any_of", "required_fact_types", "not_applicable_if_any"],
          "properties": {
            "trigger_all_of": {"$ref": "#/$defs/nonEmptyStringArray"},
            "trigger_any_of": {"$ref": "#/$defs/stringArray"},
            "required_fact_types": {"$ref": "#/$defs/nonEmptyStringArray"},
            "not_applicable_if_any": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "required_story_facts": {"$ref": "#/$defs/nonEmptyStringArray"},
        "applicable_when": {"$ref": "#/$defs/nonEmptyStringArray"},
        "not_applicable_when": {"$ref": "#/$defs/nonEmptyStringArray"},
        "director_decision": {"type": "string", "minLength": 1},
        "coverage": {"type": "string", "minLength": 1},
        "blocking": {"type": "string", "minLength": 1},
        "pacing": {"type": "string", "minLength": 1},
        "edit_logic": {"type": "string", "minLength": 1},
        "continuity": {"type": "string", "minLength": 1},
        "ai_risk": {"$ref": "#/$defs/risk"},
        "failure_modes": {"$ref": "#/$defs/nonEmptyStringArray"},
        "fallback": {"$ref": "#/$defs/fallback"},
        "confidence": {
          "type": "object", "additionalProperties": false,
          "required": ["within_source", "transfer", "execution"],
          "properties": {
            "within_source": {"enum": ["LOW", "MEDIUM", "HIGH"]},
            "transfer": {"enum": ["LOW", "MEDIUM", "HIGH"]},
            "execution": {"enum": ["LOW", "MEDIUM", "HIGH"]}
          }
        },
        "supporting_relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/relation"}},
        "counterexample": {"$ref": "#/$defs/relation"},
        "positive_forward_test_id": {"type": "string", "minLength": 1},
        "boundary_forward_test_id": {"type": "string", "minLength": 1},
        "selection_rank": {"type": "integer", "minimum": 1},
        "audio_dependency": {"type": "boolean", "const": false},
        "runtime_authorized": {"type": "boolean", "const": true},
        "surface_copy_allowed": {"type": "boolean", "const": false}
      }
    }
  }
}
